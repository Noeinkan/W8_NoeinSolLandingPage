---json
{
  "lang": "en",
  "slug": "bep-checklist",
  "title": "ISO 19650 BEP Readiness Checklist | Andrea Aita",
  "description": "Interactive ISO 19650 BEP readiness checklist. Score your pre-submission response across 7 sections, diagnose weak areas, and download a tailored PDF report.",
  "ogTitle": "ISO 19650 BEP Readiness Checklist | Andrea Aita",
  "ogDescription": "Score your BEP submission across 7 sections, diagnose gaps, and export a PDF report.",
  "ogImageAlt": "Noein Solutions — Information Management and Digital Delivery Consulting",
  "css": [
    "bep-checklist.css"
  ],
  "js": [
    "bep-checklist.js"
  ],
  "navClass": "no-print",
  "footerClass": "no-print",
  "footerGithub": true,
  "hasMirror": true,
  "calendly": true
}
---
{% from "macros/blocks.njk" import sectionHead %}
<main id="main-content">

  <div class="page-hero no-print">
    <div class="page-hero-inner">
      <div class="hero-label">Free Tool &middot; ISO 19650</div>
      <h1>BEP readiness <em>in 7 minutes</em></h1>
      <p class="page-hero-sub">Interactive pre-submission diagnostic. Tick what you can evidence, get a readiness score, weak-area diagnosis, and a tailored PDF report.</p>
      <p class="page-hero-note">Your answers stay in your browser. Nothing is submitted, stored, or transmitted &mdash; not even to us. &nbsp;&middot;&nbsp; Working on the EIR first? Try the <a href="eir-checklist.html" class="link-inline">EIR clarity check</a>.</p>
    </div>
  </div>
  <div class="eir-cross-link-wrap no-print">
    <div class="eir-cross-link">
      <strong>Reviewing the EIR side first?</strong>
      <span>Try the new <a href="eir-checklist.html">EIR Health Check</a> &mdash; 12 questions on a 0&ndash;3 clarity scale, your 3 most expensive gaps, and a free PDF report.</span>
    </div>
  </div>

  <section class="band band--sunk bep-tool" aria-label="BEP readiness checklist">
    <div class="band-inner">
      <div class="bep-layout">

      <!-- Left column: the form -->
      <form id="bepForm" class="bep-form" novalidate autocomplete="off">

        <!-- Project info -->
        <fieldset class="bep-card bep-project">
          <legend class="bep-card-title">Project details <span class="bep-optional">(optional &mdash; appears on the PDF)</span></legend>
          <div class="bep-grid-3">
            <div class="form-group">
              <label for="bep-project">Project</label>
              <input type="text" id="bep-project" name="project" placeholder="Project name">
            </div>
            <div class="form-group">
              <label for="bep-author">Prepared by</label>
              <input type="text" id="bep-author" name="author" placeholder="Your name">
            </div>
            <div class="form-group">
              <label for="bep-date">Date</label>
              <input type="date" id="bep-date" name="date">
            </div>
          </div>

          <div class="bep-context">
            <div class="bep-context-label">BEP stage</div>
            <label class="bep-radio">
              <input type="radio" name="context" value="pre-appointment" checked>
              <span class="bep-radio-label">
                <strong>Pre-appointment</strong>
                <span class="bep-radio-sub">Tender stage response</span>
              </span>
            </label>
            <label class="bep-radio">
              <input type="radio" name="context" value="delivery">
              <span class="bep-radio-label">
                <strong>Delivery team</strong>
                <span class="bep-radio-sub">Post-appointment confirmation</span>
              </span>
            </label>
          </div>
        </fieldset>

        <!-- Checklist sections (rendered by JS from data below for maintainability, but also present as static markup for progressive enhancement) -->
        <div id="bepSections"></div>

        <div class="bep-actions no-print">
          <button type="button" id="bepReset" class="btn btn-outline">Reset all answers</button>
          <button type="button" id="bepJumpResults" class="btn btn-primary">See my score &amp; report</button>
        </div>
      </form>

      <!-- Right column: sticky score + results -->
      <aside class="bep-sidebar" aria-label="Live score">
        <div class="bep-score-card" id="bepScoreCard" aria-live="polite">
          <div class="bep-score-label">Readiness score</div>
          <div class="bep-score-value">
            <span id="bepScoreNum">0</span><span class="bep-score-max">/ 35</span>
          </div>
          <div class="bep-score-bar">
            <div class="bep-score-bar-fill" id="bepScoreFill"></div>
          </div>
          <div class="bep-score-band" id="bepScoreBand">Start ticking items to see your band</div>
          <div class="bep-score-breakdown" id="bepScoreBreakdown"></div>
        </div>
      </aside>

      </div>
    </div>
  </section>

  <!-- Results panel: shown after user clicks "See my report" and always rendered for print -->
  <section id="bepResults" class="band bep-results" aria-label="Your readiness report" hidden>
    <div class="band-inner">

      <div class="bep-report-header">
        {{ sectionHead("Your Readiness Report") }}
        <h2 id="bepReportTitle" class="section-title">Your BEP readiness report</h2>
        <div class="bep-report-meta" id="bepReportMeta"></div>
      </div>

      <div class="bep-report-grid">
        <div class="bep-report-score">
          <div class="bep-report-score-num" id="bepReportScoreNum">0 / 35</div>
          <div class="bep-report-score-band" id="bepReportBand">&mdash;</div>
          <p class="bep-report-score-interp" id="bepReportInterp"></p>
        </div>
        <div class="bep-report-sections">
          <h3 class="bep-report-h3">Section-by-section breakdown</h3>
          <div class="bep-report-sections-list" id="bepReportSectionsList"></div>
        </div>
      </div>

      <div class="bep-report-diagnosis">
        <h3 class="bep-report-h3">Your weakest areas &amp; how to close them</h3>
        <div id="bepReportDiagnosis"></div>
      </div>

      <div class="bep-report-cta no-print">
        <h3 class="bep-report-h3">Want the gaps closed, not just listed?</h3>
        <p class="bep-report-cta-sub">Capsar.io reads your EIR and guides your BEP response. If the gaps above are structural rather than clerical, a 30-minute call is usually faster than another revision.</p>
        <div class="hero-actions">
          <a href="{{ site.calendly }}" onclick="Calendly.initPopupWidget({url:'{{ site.calendly }}'});return false;" class="btn btn-primary">Book a 30-min call</a>
          <a href="capsar.html" class="btn btn-outline btn-outline--on-dark">Learn about Capsar.io</a>
        </div>
      </div>

      <div class="bep-report-actions no-print">
        <button type="button" id="bepPrintBtn" class="btn btn-primary">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="1.8" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Export PDF report
        </button>
        <p class="form-note">Opens a clean export view optimised for PDF. In the print dialog, choose <strong>&ldquo;Save as PDF&rdquo;</strong>; if your browser adds headers or footers, switch them off in More settings.</p>
      </div>

      <div class="bep-report-footer">
        <p>Generated with the ISO 19650 BEP Readiness Checklist &middot; <a href="https://noeinsolutions.com/bep-checklist.html">noeinsolutions.com/bep-checklist.html</a></p>
        <p class="bep-report-disclaimer">This is practical guidance and does not replace contractual or legal review.</p>
      </div>

    </div>
  </section>

</main>
