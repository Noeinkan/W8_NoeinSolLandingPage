---json
{
  "lang": "en",
  "slug": "contact",
  "title": "Contact — Book a Call or Send a Brief | Andrea Aita",
  "description": "Book a 30-minute call or send a brief to discuss information management, CDE governance, BEP and EIR support, AI automation sprints, or programme digital delivery.",
  "ogTitle": "Contact — Book a Call or Send a Brief | Andrea Aita",
  "ogDescription": "Book a 30-minute call or send a brief. Information management, BEP and EIR, AI automation sprints, programme delivery.",
  "ogImageAlt": "Andrea Aita — contact",
  "css": [
    "contact.css"
  ],
  "calendly": true,
  "hasMirror": true
}
---
<main id="main-content">

  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="hero-label">Contact</div>
      <h1>Bring the problem. <em>Not a brief.</em></h1>
      <p class="page-hero-sub">Thirty minutes is usually enough to work out whether I can help and what it would take. If I am not the right person, I will say so on the call.</p>
    </div>
  </div>

  <section class="fade-in" aria-label="Book a call or send a message">

    <div class="contact-grid">

      <div class="contact-col">
        <h2>Book a 30-min call</h2>
        <p>Pick a slot directly. No forms, no qualification call before the call.</p>

        <div class="calendly-embed-wrapper">
          <div class="calendly-embed"
               data-calendly-url="{{ site.calendly }}?hide_gdpr_banner=1&amp;background_color=FAF9F6&amp;text_color=14161A&amp;primary_color=F04E23"
               data-calendly-resize="true">
            <p class="calendly-fallback">
              The booking calendar could not load — it needs a third-party script that your browser or network may be blocking.
              <a href="{{ site.calendly }}" target="_blank" rel="noopener noreferrer">Open the booking page directly</a>,
              or email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
            </p>
          </div>
        </div>

        <div class="contact-direct">
          <div class="contact-direct-item">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </div>
          <div class="contact-direct-item">
            <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
          <div class="contact-direct-item">
            <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            London, UK &mdash; UK &amp; EU
          </div>
        </div>
      </div>

      <div class="contact-col">
        <h2>Send a brief</h2>
        <p>If a call is premature, write instead. Project type, stage, and what is actually hurting is plenty to start with.</p>

        <div class="contact-success" id="contactSuccess" role="status">
          <h3>Message sent.</h3>
          <p>Thanks — it landed. I reply to everything within one working day, usually sooner.</p>
        </div>

        <form action="https://formsubmit.co/{{ site.email }}" method="POST" novalidate>
          <input type="hidden" name="_subject" value="New enquiry from noeinsolutions.com">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_next" value="{{ site.base }}/contact.html?sent=1">
          <input type="text" name="_honey" class="contact-honey" tabindex="-1" autocomplete="off" aria-hidden="true">

          <div class="contact-field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required aria-required="true" autocomplete="name">
          </div>
          <div class="contact-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required aria-required="true" autocomplete="email">
          </div>
          <div class="contact-field">
            <label for="company">Company <span class="contact-optional">(optional)</span></label>
            <input type="text" id="company" name="company" autocomplete="organization">
          </div>
          <div class="contact-field">
            <label for="service">What is this about?</label>
            <select id="service" name="service" required aria-required="true">
              <option value="" disabled selected>Select a service area</option>
              <option value="AI &amp; automation sprint">AI &amp; automation sprint</option>
              <option value="Information management &amp; strategy">Information management &amp; strategy</option>
              <option value="BEP &amp; EIR production">BEP &amp; EIR production</option>
              <option value="Programme digital delivery">Programme digital delivery</option>
              <option value="Capsar.io access">Capsar.io access</option>
              <option value="Something else">Something else</option>
            </select>
          </div>
          <div class="contact-field">
            <label for="messageField">The problem</label>
            <textarea id="messageField" name="message" required aria-required="true" placeholder="Project type, stage, timeline, and what is going wrong."></textarea>
          </div>

          <button type="submit" class="btn btn-primary contact-submit">Send the brief</button>
        </form>
      </div>

    </div>
  </section>

  <script>
    (function () {
      // Success panel after formsubmit.co bounces back to ?sent=1.
      if (window.location.search.indexOf('sent=1') !== -1) {
        var panel = document.getElementById('contactSuccess');
        if (panel) {
          panel.classList.add('is-visible');
          panel.scrollIntoView({ block: 'center' });
        }
      }

      // Calendly inline widget. Retried on load and on an interval because the
      // widget script is async — on a slow connection it can arrive after this
      // runs, and a single attempt would leave an empty box behind.
      var tries = 0;
      function initCalendly() {
        var el = document.querySelector('.calendly-embed[data-calendly-url]');
        if (!el || el.getAttribute('data-calendly-initialized') === 'true') return true;
        if (typeof Calendly === 'undefined' || !Calendly.initInlineWidget) return false;
        el.innerHTML = '';
        Calendly.initInlineWidget({
          url: el.getAttribute('data-calendly-url'),
          parentElement: el,
          resize: el.getAttribute('data-calendly-resize') === 'true'
        });
        el.setAttribute('data-calendly-initialized', 'true');
        return true;
      }

      if (!initCalendly()) {
        var timer = setInterval(function () {
          // ~10s of retries, then give up and leave the fallback copy visible.
          if (initCalendly() || ++tries > 40) clearInterval(timer);
        }, 250);
      }
    })();
  </script>

</main>
