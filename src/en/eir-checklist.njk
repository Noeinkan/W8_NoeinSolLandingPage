---json
{
  "lang": "en",
  "slug": "eir-checklist",
  "title": "ISO 19650 EIR Health Check | Andrea Aita",
  "description": "Free ISO 19650 EIR clarity diagnostic. Rate 12 questions on a 0–3 scale, see your /100 clarity score, the 3 most expensive gaps, and export a PDF report. No email required.",
  "ogTitle": "ISO 19650 EIR Health Check | Andrea Aita",
  "ogDescription": "Rate your EIR on 12 questions across 4 sections, see your /100 clarity score and the 3 most expensive gaps, and export a PDF report. No email, no gating.",
  "ogImageAlt": "Noein Solutions — Information Management and Digital Delivery Consulting",
  "css": [
    "bep-checklist.css",
    "eir-checklist.css"
  ],
  "js": [
    "eir-checklist.js"
  ],
  "navClass": "no-print",
  "footerClass": "no-print",
  "footerGithub": true,
  "hasMirror": true,
  "calendly": true
}
---
{% from "macros/blocks.njk" import sectionHead %}
<main id="main-content">

  <div class="page-hero no-print">
    <div class="page-hero-inner">
      <div class="hero-label">Free Tool &middot; ISO 19650</div>
      <h1>EIR clarity in <em>5 minutes</em></h1>
      <p class="page-hero-sub">Rate 12 questions across 4 sections on a 0&ndash;3 clarity scale, see your /100 score, the 3 most expensive gaps, and the full breakdown. Export a PDF report when you&rsquo;re ready.</p>
      <p class="page-hero-note">Your answers stay in your browser. Nothing is submitted, stored, or transmitted &mdash; not even to us. &nbsp;&middot;&nbsp; Part of the <a href="iso-19650.html" class="link-inline">ISO 19650 toolkit</a>.</p>
    </div>
  </div>


  <section class="band band--sunk bep-tool" aria-label="EIR clarity health check">
    <div class="band-inner">
      <div class="bep-layout">

      <!-- Left column: the form -->
      <form id="eirForm" class="eir-form bep-form" novalidate autocomplete="off">

        <!-- Project info -->
        <fieldset class="bep-card eir-project">
          <legend class="bep-card-title">Project details <span class="bep-optional">(optional &mdash; appears on the PDF)</span></legend>
          <div class="bep-grid-3 eir-grid-3">
            <div class="form-group">
              <label for="eir-project">Project</label>
              <input type="text" id="eir-project" name="project" placeholder="Project name">
            </div>
            <div class="form-group">
              <label for="eir-author">Prepared by</label>
              <input type="text" id="eir-author" name="author" placeholder="Your name">
            </div>
            <div class="form-group">
              <label for="eir-date">Date</label>
              <input type="date" id="eir-date" name="date">
            </div>
          </div>
        </fieldset>

        <!-- Checklist sections (rendered by js/eir-checklist.js from data) -->
        <div id="eirSections"></div>

        <div class="bep-actions no-print">
          <button type="button" id="eirReset" class="btn btn-outline">Reset all answers</button>
          <button type="button" id="eirJumpResults" class="btn btn-primary">See my score &amp; report</button>
        </div>
      </form>

      <!-- Right column: sticky score + results -->
      <aside class="bep-sidebar" aria-label="Live clarity score">
        <div class="bep-score-card" id="eirScoreCard" aria-live="polite">
          <div class="bep-score-label">Clarity score</div>
          <div class="bep-score-value">
            <span id="eirScoreNum">0</span><span class="bep-score-max"><span class="eir-score-max-suffix">/ 100</span></span>
          </div>
          <div class="bep-score-bar">
            <div class="bep-score-bar-fill" id="eirScoreFill"></div>
          </div>
          <div class="bep-score-band" id="eirScoreBand">Start rating questions to see your band</div>
          <div class="bep-score-breakdown" id="eirScoreBreakdown"></div>
        </div>
      </aside>

      </div>
    </div>
  </section>

  <!-- Results panel: shown after user clicks "See my report" and always rendered for print -->
  <section id="eirResults" class="band bep-results" aria-label="Your clarity report" hidden>
    <div class="band-inner">

        <div class="bep-report-header">
          {{ sectionHead("Your Clarity Report") }}
          <h2 id="eirReportTitle" class="section-title">Your EIR clarity report</h2>
          <div class="bep-report-meta" id="eirReportMeta"></div>
        </div>

        <div class="bep-report-grid">
          <div class="bep-report-score">
            <div class="bep-report-score-num" id="eirReportScoreNum">0 / 100</div>
            <div class="bep-report-score-band" id="eirReportBand">&mdash;</div>
            <p class="bep-report-score-interp" id="eirReportInterp"></p>
          </div>
          <div class="bep-report-sections">
            <h3 class="bep-report-h3">Section-by-section breakdown</h3>
            <div class="bep-report-sections-list" id="eirReportSectionsList"></div>
          </div>
        </div>

        <div class="bep-report-diagnosis">
          <h3 class="bep-report-h3">Your three most expensive gaps</h3>
          <div class="eir-gap-grid" id="eirReportGaps"></div>
        </div>

        <div class="bep-report-diagnosis">
          <h3 class="bep-report-h3">Full 12-question breakdown</h3>
          <div class="eir-breakdown" id="eirReportBreakdown"></div>
        </div>

        <div class="bep-report-cta no-print eir-cta-block">
          <h3 class="bep-report-h3">Need help closing the gaps?</h3>
          <p class="eir-cta-sub">Book a 30-minute call and I&rsquo;ll give you a short, no-pressure read of what would tighten it most &mdash; or send the report over by email if a call is premature.</p>
          <div class="hero-actions">
            <a href="{{ site.calendly }}" onclick="Calendly.initPopupWidget({url:'{{ site.calendly }}'});return false;" class="btn btn-primary">Book a 30-min call</a>
            <a href="mailto:{{ site.email }}?subject=EIR%20Health%20Check%20follow-up" class="btn btn-outline btn-outline--on-dark">Email me the report</a>
          </div>
          <div class="eir-cta-divider">or jump to</div>
          <div class="eir-crosslinks">
            <a href="bep-checklist.html">BEP Readiness Checklist</a>
            <a href="capsar.html">Capsar.io platform</a>
            <a href="about.html">About Andrea</a>
          </div>
        </div>

        <div class="bep-report-actions no-print">
          <button type="button" id="eirPrintBtn" class="btn btn-primary">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="1.8" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Export PDF report
          </button>
          <p class="form-note">Opens a clean export view optimised for PDF. In the print dialog, choose <strong>&ldquo;Save as PDF&rdquo;</strong>; if your browser adds headers or footers, switch them off in More settings.</p>
        </div>

        <div class="bep-report-footer">
          <p>Generated with the ISO 19650 EIR Health Check &middot; <a href="https://noeinsolutions.com/eir-checklist.html">noeinsolutions.com/eir-checklist.html</a></p>
          <p class="bep-report-disclaimer">Practical guidance &mdash; not a substitute for contractual or legal review.</p>
        </div>

    </div>
  </section>

  </main>
